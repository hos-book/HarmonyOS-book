import { AppThemeBundle } from '../../model/AppThemeBundle';
import { AppThemeVisual, ThemeBackgroundKind, ThemeCoverDecoration, ThemeIconRole } from '../../model/AppThemeVisual';

export function createApricotTheme(): AppThemeBundle {
  const visual: AppThemeVisual = new AppThemeVisual();
  visual.colors.background = $r('app.color.theme_apricot_background');
  visual.colors.surface = $r('app.color.theme_apricot_surface');
  visual.colors.profileMenuSurface = $r('app.color.theme_apricot_surface');
  visual.colors.textPrimary = $r('app.color.theme_apricot_text_primary');
  visual.colors.textSecondary = $r('app.color.theme_apricot_text_secondary');
  visual.colors.textTertiary = $r('app.color.theme_apricot_text_tertiary');
  visual.colors.iconPrimary = visual.colors.textPrimary;
  visual.colors.iconSecondary = visual.colors.textSecondary;
  visual.colors.divider = $r('app.color.theme_apricot_divider');
  visual.colors.brand = $r('app.color.theme_apricot_brand');
  visual.colors.brandHover = $r('app.color.theme_apricot_brand_hover');
  visual.colors.brandPressed = $r('app.color.theme_apricot_brand_pressed');
  visual.colors.brandDisabled = $r('app.color.theme_apricot_brand_disabled');
  visual.colors.brandSoft = $r('app.color.theme_apricot_brand_soft');
  visual.colors.brandDark = visual.colors.brandPressed;
  visual.colors.onBrand = $r('app.color.theme_apricot_on_brand');
  visual.colors.controlFallback = $r('app.color.theme_apricot_control');
  visual.colors.controlTint = visual.colors.controlFallback;
  visual.colors.stroke = visual.colors.divider;
  visual.colors.shadow = $r('app.color.theme_apricot_shadow');
  visual.colors.appDivider = visual.colors.divider;
  visual.colors.homeTop = visual.colors.background;
  visual.colors.homeMid = visual.colors.background;
  visual.colors.homeBottom = visual.colors.background;
  visual.colors.statusScrim = $r('app.color.theme_apricot_status_scrim');
  visual.colors.floatingMask = $r('app.color.theme_apricot_floating_mask');
  visual.colors.homeAccent = visual.colors.brand;
  visual.colors.homeAccentSoft = visual.colors.brandSoft;
  visual.colors.homeControl = visual.colors.controlFallback;
  visual.colors.homeSurface = visual.colors.surface;
  visual.colors.homeShadow = visual.colors.shadow;
  visual.colors.progressTrack = visual.colors.divider;
  visual.colors.detailTop = visual.colors.background;
  visual.colors.detailMid = visual.colors.surface;
  visual.colors.detailBottom = visual.colors.surface;
  visual.colors.settingsBackground = visual.colors.background;
  visual.background.kind = ThemeBackgroundKind.Image;
  visual.background.image = $r('app.media.theme_apricot_background');
  visual.background.shelfImage = $r('app.media.theme_apricot_shelf_background');
  visual.background.recordImage = $r('app.media.theme_apricot_record_background');
  visual.background.profileCardImage = $r('app.media.theme_apricot_profile_card');
  visual.background.showCoverBackdrop = false;
  visual.cover.placeholder = $r('app.media.theme_apricot_cover');
  visual.cover.localPlaceholder = $r('app.media.theme_apricot_local_cover');
  visual.cover.playerPlaceholder = visual.cover.placeholder;
  visual.cover.title = $r('app.color.theme_apricot_cover_text');
  visual.cover.localTitle = $r('app.color.theme_apricot_local_cover_text');
  visual.cover.author = $r('app.color.theme_apricot_local_cover_author');
  visual.cover.authorBackground = $r('app.color.theme_apricot_cover_label');
  visual.cover.label = visual.cover.authorBackground;
  visual.cover.edge = visual.colors.brand;
  visual.cover.decoration = ThemeCoverDecoration.Spine;
  visual.cover.illustratedPlaceholder = true;
  visual.brandedProfileIcons = true;
  visual.icons.set(ThemeIconRole.Search, $r('app.media.theme_paper_search'));
  visual.icons.set(ThemeIconRole.Filter, $r('app.media.theme_paper_filter'));
  visual.icons.set(ThemeIconRole.Grid, $r('app.media.theme_paper_grid'));
  visual.icons.set(ThemeIconRole.List, $r('app.media.theme_paper_list'));
  visual.icons.set(ThemeIconRole.Home, $r('app.media.theme_paper_home'));
  visual.icons.set(ThemeIconRole.Shelf, $r('app.media.theme_paper_shelf'));
  visual.icons.set(ThemeIconRole.Record, $r('app.media.theme_paper_record'));
  visual.icons.set(ThemeIconRole.Profile, $r('app.media.theme_paper_profile'));
  visual.icons.set(ThemeIconRole.Category, $r('app.media.theme_paper_category'));
  return new AppThemeBundle('apricot-study', $r('app.string.theme_bundle_apricot_name'),
    $r('app.string.theme_bundle_apricot_description'), '#857050', visual);
}

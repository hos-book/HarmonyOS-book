import { AppThemeBundle } from '../../model/AppThemeBundle';
import { AppThemeVisual, ThemeBackgroundKind, ThemeCoverDecoration, ThemeIconRole } from '../../model/AppThemeVisual';

export function createMistTheme(): AppThemeBundle {
  const visual = new AppThemeVisual();
  visual.colors.background = $r('app.color.theme_mist_background');
  visual.colors.surface = $r('app.color.theme_mist_surface');
  visual.colors.textPrimary = $r('app.color.theme_mist_text_primary');
  visual.colors.textSecondary = $r('app.color.theme_mist_text_secondary');
  visual.colors.textTertiary = $r('app.color.theme_mist_text_tertiary');
  visual.colors.iconPrimary = $r('app.color.theme_mist_text_primary');
  visual.colors.iconSecondary = $r('app.color.theme_mist_text_secondary');
  visual.colors.divider = $r('app.color.theme_mist_divider');
  visual.colors.brand = $r('app.color.theme_mist_brand');
  visual.colors.brandHover = $r('app.color.theme_mist_brand_hover');
  visual.colors.brandPressed = $r('app.color.theme_mist_brand_pressed');
  visual.colors.brandDisabled = $r('app.color.theme_mist_brand_disabled');
  visual.colors.brandSoft = $r('app.color.theme_mist_brand_soft');
  visual.colors.brandDark = $r('app.color.theme_mist_brand_pressed');
  visual.colors.onBrand = $r('app.color.theme_mist_on_brand');
  visual.colors.controlFallback = $r('app.color.theme_mist_control');
  visual.colors.controlTint = $r('app.color.theme_mist_control');
  visual.colors.stroke = $r('app.color.theme_mist_divider');
  visual.colors.shadow = $r('app.color.theme_mist_shadow');
  visual.colors.appDivider = $r('app.color.theme_mist_divider');
  visual.colors.homeTop = $r('app.color.theme_mist_background');
  visual.colors.homeMid = $r('app.color.theme_mist_background');
  visual.colors.homeBottom = $r('app.color.theme_mist_background');
  visual.colors.statusScrim = $r('app.color.theme_mist_status_scrim');
  visual.colors.floatingMask = $r('app.color.theme_mist_floating_mask');
  visual.colors.homeAccent = $r('app.color.theme_mist_brand');
  visual.colors.homeAccentSoft = $r('app.color.theme_mist_brand_soft');
  visual.colors.homeControl = $r('app.color.theme_mist_control');
  visual.colors.homeSurface = $r('app.color.theme_mist_surface');
  visual.colors.homeShadow = $r('app.color.theme_mist_shadow');
  visual.colors.progressTrack = $r('app.color.theme_mist_divider');
  visual.colors.detailTop = $r('app.color.theme_mist_background');
  visual.colors.detailMid = $r('app.color.theme_mist_surface');
  visual.colors.detailBottom = $r('app.color.theme_mist_surface');
  visual.colors.settingsBackground = $r('app.color.theme_mist_background');
  visual.background.kind = ThemeBackgroundKind.Solid;
  visual.background.showCoverBackdrop = false;
  visual.cover.placeholder = $r('app.media.theme_mist_cover');
  visual.cover.localPlaceholder = $r('app.media.theme_mist_local_cover');
  visual.cover.playerPlaceholder = visual.cover.placeholder;
  visual.cover.title = $r('app.color.theme_mist_cover_text');
  visual.cover.localTitle = $r('app.color.theme_mist_local_cover_text');
  visual.cover.author = $r('app.color.theme_mist_local_cover_author');
  visual.cover.label = $r('app.color.theme_mist_cover_label');
  visual.cover.edge = visual.colors.textSecondary;
  visual.cover.decoration = ThemeCoverDecoration.Spine;
  visual.cover.illustratedPlaceholder = true;
  visual.brandedProfileIcons = true;
  visual.icons.set(ThemeIconRole.Search, $r('app.media.theme_mist_search'));
  visual.icons.set(ThemeIconRole.Filter, $r('app.media.theme_mist_filter'));
  visual.icons.set(ThemeIconRole.Grid, $r('app.media.theme_mist_grid'));
  visual.icons.set(ThemeIconRole.List, $r('app.media.theme_mist_list'));
  visual.icons.set(ThemeIconRole.ChevronRight, $r('app.media.theme_mist_chevron_right'));
  visual.icons.set(ThemeIconRole.Home, $r('app.media.theme_mist_home'));
  visual.icons.set(ThemeIconRole.Shelf, $r('app.media.theme_mist_shelf'));
  visual.icons.set(ThemeIconRole.Record, $r('app.media.theme_mist_record'));
  visual.icons.set(ThemeIconRole.Profile, $r('app.media.theme_mist_profile'));
  visual.icons.set(ThemeIconRole.Category, $r('app.media.theme_mist_category'));
  return new AppThemeBundle('mist-blue', $r('app.string.theme_bundle_mist_name'),
    $r('app.string.theme_bundle_mist_description'), '#3F647F', 3, visual);
}

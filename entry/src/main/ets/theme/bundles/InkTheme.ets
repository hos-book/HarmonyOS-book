import { AppThemeBundle } from '../../model/AppThemeBundle';
import { AppThemeVisual, ThemeBackgroundKind, ThemeCoverDecoration, ThemeIconRole } from '../../model/AppThemeVisual';

export function createInkTheme(): AppThemeBundle {
  const visual = new AppThemeVisual();
  visual.colors.background = $r('app.color.theme_ink_background');
  visual.colors.surface = $r('app.color.theme_ink_surface');
  visual.colors.textPrimary = $r('app.color.theme_ink_text_primary');
  visual.colors.textSecondary = $r('app.color.theme_ink_text_secondary');
  visual.colors.textTertiary = $r('app.color.theme_ink_text_tertiary');
  visual.colors.iconPrimary = $r('app.color.theme_ink_text_primary');
  visual.colors.iconSecondary = $r('app.color.theme_ink_text_secondary');
  visual.colors.divider = $r('app.color.theme_ink_divider');
  visual.colors.brand = $r('app.color.theme_ink_brand');
  visual.colors.brandHover = $r('app.color.theme_ink_brand_hover');
  visual.colors.brandPressed = $r('app.color.theme_ink_brand_pressed');
  visual.colors.brandDisabled = $r('app.color.theme_ink_brand_disabled');
  visual.colors.brandSoft = $r('app.color.theme_ink_brand_soft');
  visual.colors.brandDark = $r('app.color.theme_ink_brand_pressed');
  visual.colors.onBrand = $r('app.color.theme_ink_on_brand');
  visual.colors.controlFallback = $r('app.color.theme_ink_control');
  visual.colors.controlTint = $r('app.color.theme_ink_control');
  visual.colors.stroke = $r('app.color.theme_ink_divider');
  visual.colors.shadow = $r('app.color.theme_ink_shadow');
  visual.colors.appDivider = $r('app.color.theme_ink_divider');
  visual.colors.homeTop = $r('app.color.theme_ink_background');
  visual.colors.homeMid = $r('app.color.theme_ink_background');
  visual.colors.homeBottom = $r('app.color.theme_ink_background');
  visual.colors.statusScrim = $r('app.color.theme_ink_status_scrim');
  visual.colors.floatingMask = $r('app.color.theme_ink_floating_mask');
  visual.colors.homeAccent = $r('app.color.theme_ink_brand');
  visual.colors.homeAccentSoft = $r('app.color.theme_ink_brand_soft');
  visual.colors.homeControl = $r('app.color.theme_ink_control');
  visual.colors.homeSurface = $r('app.color.theme_ink_surface');
  visual.colors.homeShadow = $r('app.color.theme_ink_shadow');
  visual.colors.progressTrack = $r('app.color.theme_ink_divider');
  visual.colors.detailTop = $r('app.color.theme_ink_background');
  visual.colors.detailMid = $r('app.color.theme_ink_surface');
  visual.colors.detailBottom = $r('app.color.theme_ink_surface');
  visual.colors.settingsBackground = $r('app.color.theme_ink_background');
  visual.background.kind = ThemeBackgroundKind.Image;
  visual.background.image = $r('app.media.theme_ink_background');
  visual.background.imageOpacity = 0.12;
  visual.background.showCoverBackdrop = false;
  visual.cover.placeholder = $r('app.media.theme_ink_cover');
  visual.cover.localPlaceholder = $r('app.media.theme_ink_local_cover');
  visual.cover.playerPlaceholder = visual.cover.placeholder;
  visual.cover.title = $r('app.color.theme_ink_cover_text');
  visual.cover.localTitle = $r('app.color.theme_ink_local_cover_text');
  visual.cover.author = $r('app.color.theme_ink_local_cover_author');
  visual.cover.authorBackground = $r('app.color.theme_ink_cover_label');
  visual.cover.label = $r('app.color.theme_ink_cover_label');
  visual.cover.edge = visual.colors.textSecondary;
  visual.cover.decoration = ThemeCoverDecoration.Border;
  visual.cover.illustratedPlaceholder = true;
  visual.brandedProfileIcons = true;
  visual.icons.set(ThemeIconRole.Search, $r('app.media.theme_ink_search'));
  visual.icons.set(ThemeIconRole.Filter, $r('app.media.theme_ink_filter'));
  visual.icons.set(ThemeIconRole.Grid, $r('app.media.theme_ink_grid'));
  visual.icons.set(ThemeIconRole.List, $r('app.media.theme_ink_list'));
  visual.icons.set(ThemeIconRole.ChevronRight, $r('app.media.theme_ink_chevron_right'));
  visual.icons.set(ThemeIconRole.Home, $r('app.media.theme_ink_home'));
  visual.icons.set(ThemeIconRole.Shelf, $r('app.media.theme_ink_shelf'));
  visual.icons.set(ThemeIconRole.Record, $r('app.media.theme_ink_record'));
  visual.icons.set(ThemeIconRole.Profile, $r('app.media.theme_ink_profile'));
  visual.icons.set(ThemeIconRole.Category, $r('app.media.theme_ink_category'));
  return new AppThemeBundle('ink-wash', $r('app.string.theme_bundle_ink_name'),
    $r('app.string.theme_bundle_ink_description'), '#A34335', 3, visual);
}

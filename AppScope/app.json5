      { "name": "retro", "icon": "$media:app_icon_retro" },
      { "name": "cartoon", "icon": "$media:app_icon_cartoon" },
      { "name": "cartooncat", "icon": "$media:app_icon_cartooncat" },
      { "name": "cartoondog", "icon": "$media:app_icon_cartoondog" },
      { "name": "wave", "icon": "$media:app_icon_wave" },
      { "name": "life", "icon": "$media:app_icon_life" },
      { "name": "lifewhite", "icon": "$media:app_icon_lifewhite" },
      { "name": "waveberry", "icon": "$media:app_icon_waveberry" },

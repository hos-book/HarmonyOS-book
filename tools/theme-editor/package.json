{
  "name": "jianting-theme-editor",
  "version": "1.0.0",
  "description": "简听阅读主题制作器",
  "author": "JianTing",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "setup:desktop": "node scripts/install-electron.mjs",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "vite": "8.4.0"
  },
  "build": {
    "appId": "com.huan.listenbook.themeeditor",
    "productName": "简听主题制作器",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "JianTing-Theme-Editor-${version}.exe" }
  }
}
